# Your Vonage application, created with `vonage apps create`
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./private.key

# Used to verify that webhooks come from Vonage.
# Find it in the Vonage Dashboard under API Settings.
VONAGE_SIGNATURE_SECRET=

# The Vonage number you bought (the caller) and the number to call,
# both in E.164 format without a leading + (e.g. 14155550100)
VONAGE_FROM_NUMBER=
VONAGE_TO_NUMBER=

# The public URL shown by `vonage tunnel ngrok`
BASE_URL=
